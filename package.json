{
  "name": "auth-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "dev": "vite --host 0.0.0.0",
    "server": "node scripts/start-server.cjs",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "check:auth": "node scripts/check-auth-integration.cjs",
    "db:deploy": "prisma migrate deploy",
    "check:vault-crypto": "node scripts/check-vault-crypto.cjs",
    "vault:rotate-key": "tsx scripts/rotate-vault-key.ts",
    "check:google": "node scripts/check-google-auth.cjs",
    "check:password": "node scripts/check-password-security.cjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "@prisma/client": "6.19.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "7.5.0",
    "jsonwebtoken": "^9.0.2",
    "@react-oauth/google": "^0.12.2",
    "google-auth-library": "^9.15.1",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "prisma": "6.19.0",
    "tsx": "^4.19.2",
    "esbuild": "^0.21.5"
  }
}
