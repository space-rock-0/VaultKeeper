{
    "compilerOptions":  {
                            "target":  "ES2020",
                            "useDefineForClassFields":  true,
                            "lib":  [
                                        "ES2020",
                                        "DOM",
                                        "DOM.Iterable"
                                    ],
                            "module":  "ESNext",
                            "skipLibCheck":  true,
                            "moduleResolution":  "Bundler",
                            "allowImportingTsExtensions":  true,
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "noEmit":  true,
                            "jsx":  "react-jsx",
                            "strict":  true,
                            "types":  [
                                          "vite/client"
                                      ],
                            "composite":  true,
                            "esModuleInterop":  true
                        },
    "include":  [
                    "src/App.tsx",
                    "src/main.tsx",
                    "src/api/**/*.ts",
                    "src/components/**/*.tsx",
                    "src/context/**/*.tsx",
                    "src/pages/**/*.tsx"
                ]
}