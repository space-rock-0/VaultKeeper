DATABASE_URL=postgresql://ROLE:PASSWORD@HOST-pooler.neon.tech/auth?sslmode=require
DIRECT_URL=postgresql://ROLE:PASSWORD@HOST.neon.tech/auth?sslmode=require
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-bytes
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
FRONTEND_URL=http://localhost:5173
PORT=5000
NODE_ENV=development
VITE_API_URL=http://localhost:5000/api
TRUST_PROXY_HOPS=
ENCRYPTION_KEY=generate-a-unique-64-character-hex-key

# Same public Web OAuth client ID on client and server. No client secret required.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Password recovery: never put these credentials in VITE_ variables.
OTP_HASH_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
EMAIL_PROVIDER=smtp
EMAIL_FROM="Vaultkeeper <sender@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sender@gmail.com
SMTP_PASSWORD=
# Alternative: EMAIL_PROVIDER=resend with a verified sender domain.
RESEND_API_KEY=
